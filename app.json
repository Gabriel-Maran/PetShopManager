{
  "expo": {
    "name": "PetShop Manager",
    "slug": "PetShopManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo/iconApp.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo/splashApp.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo/foregroundImageApp.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.gabriel98989898.PetShopManager"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f2085da0-5287-4f67-b88e-1acfe6b01a28"
      }
    },
    "owner": "gabriel98989898"
  }
}
