{
  "expo": {
    "name": "PetShopManager",
    "slug": "PetShopManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/default_react/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/assets/default_react/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/default_react/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gabriel98989898.PetShopManager"
    },
    "web": {
      "favicon": "./app/assets/default_react/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "f2085da0-5287-4f67-b88e-1acfe6b01a28"
      }
    },
    "owner": "gabriel98989898"
  }
}
