# Proteções de instalação para quem clonar o projeto e para o build da EAS.

# Nenhum pacote roda script ao ser instalado. Hoje nenhum dos pacotes do lock precisa disso.
ignore-scripts=true

# A versão entra exata no package.json, sem ^ nem ~.
save-exact=true

# Só aceita versões publicadas há pelo menos 7 dias, para dar tempo de um pacote invadido ser retirado.
min-release-age=7
