{
  "name": "petshopmanager",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/**/*.test.mjs\"",
    "check": "npm run typecheck && npm test && npm run export:android"
  },
  "dependencies": {
    "expo": "58.0.21",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-sharing": "58.0.21",
    "expo-sqlite": "58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "1.1314.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "private": true
}
