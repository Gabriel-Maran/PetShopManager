{
  "name": "petshopmanager",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run export:android",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.23",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-sharing": "58.0.22",
    "expo-sqlite": "58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "1.1314.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-expo": "58.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "private": true
}
